# Copy to $IDENTITY_ENV_DIR/identity-egov-user.env with mode 0600.
IDENTITY_SERVICE_TOKEN=<same value as DIGIT_IDENTITY_SERVICE_TOKEN>
IDENTITY_KEYCLOAK_ISSUER=<PUBLIC_URL>/auth/realms/digit
IDENTITY_KEYCLOAK_JWKS_URI=http://keycloak:8180/realms/digit/protocol/openid-connect/certs
IDENTITY_KEYCLOAK_AUDIENCE=digit-identity-exchange
IDENTITY_KEYCLOAK_AUTHORIZED_PARTY=digit-identity-bff
IDENTITY_ALLOWED_CLIENT_ID=digit-ui
IDENTITY_EXCHANGE_TOKEN_TTL_SECONDS=900
